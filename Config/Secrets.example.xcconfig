//
//  Secrets.example.xcconfig
//  CardPulse
//
//  Copy this file to `Secrets.xcconfig` (same folder) and fill in the values.
//  Secrets.xcconfig is gitignored and must never be committed.
//
//  Both values are optional. Without them the app skips the remote category
//  lookup and categorises Wallet transactions from history plus a local
//  keyword heuristic, exactly as it did before the API existed.
//

// Host of your deployed `backend/` service — HOST ONLY, no scheme.
// xcconfig treats "//" as the start of a comment, so "https://example.com"
// would be truncated to "https:". The app prepends https:// itself.
//
//   CATEGORY_API_BASE_URL = cardpulse-api.vercel.app
CATEGORY_API_BASE_URL =

// Must match CATEGORIZE_API_TOKEN in the backend's environment.
// Generate with: openssl rand -hex 32
CATEGORY_API_TOKEN =
