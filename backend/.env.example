# Copy to .env.local for local development, and set the same keys as
# Environment Variables in the Vercel project for deployment.

# TypeSafe API key used to call Jev. Never shipped to the iOS app.
# Get one at https://typesafe.ai
TYPESAFE_API_KEY=

# Shared bearer token the iOS app must send in `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
CATEGORIZE_API_TOKEN=

# Optional. Defaults to "jev-latest".
# TYPESAFE_MODEL=jev-latest
